# Copy to .env.local for the web demo, or set on your n8n instance for the
# workflow. Names and purposes only — never commit real values.

# Web demo (api/generate.js): enables live AI generation. Without it the app
# runs in demo mode. Read server-side only, never sent to the browser.
GEMINI_API_KEY=

# n8n workflow: token for the Notion integration that owns the content calendar.
NOTION_TOKEN=

# n8n workflow: ID of the Notion database used as the content calendar.
NOTION_DATABASE_ID=

# n8n workflow: key used by the two LLM nodes (brief, then channel drafts).
OPENAI_API_KEY=

# n8n workflow: model for those LLM nodes. Optional; defaults to gpt-4o-mini.
OPENAI_MODEL=

# n8n workflow: incoming webhook for the channel that receives review pings.
SLACK_WEBHOOK_URL=

# n8n workflow: fallback brand-voice notes when a Notion page leaves them blank. Optional.
BRAND_VOICE_DEFAULT=

# n8n workflow: set to false only if your instance blocks $env access in nodes
# and you keep the values above as instance environment variables.
N8N_BLOCK_ENV_ACCESS_IN_NODE=
